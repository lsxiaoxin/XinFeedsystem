{
  "info": {
    "name": "XinFeedSystem API",
    "_postman_id": "xinfeedsystem-v1",
    "description": "视频 Feed 流后端系统 API 集合。使用前先运行「注册」或「登录」，集合变量 token / uid / video_id 会自动填充。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/api/v1" },
    { "key": "token",    "value": "" },
    { "key": "uid",      "value": "" },
    { "key": "video_id", "value": "" },
    { "key": "comment_id", "value": "" },
    { "key": "target_uid", "value": "" }
  ],
  "item": [
    {
      "name": "用户模块",
      "item": [
        {
          "name": "注册",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.code === 0) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('uid', res.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"nickname\": \"测试用户\"\n}"
            },
            "url": { "raw": "{{base_url}}/user/register", "host": ["{{base_url}}"], "path": ["user", "register"] }
          }
        },
        {
          "name": "登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.code === 0) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('uid', res.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/user/login", "host": ["{{base_url}}"], "path": ["user", "login"] }
          }
        },
        {
          "name": "获取用户信息",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/user/{{uid}}", "host": ["{{base_url}}"], "path": ["user", "{{uid}}"] }
          }
        },
        {
          "name": "获取当前用户（需鉴权）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/user/me", "host": ["{{base_url}}"], "path": ["user", "me"] }
          }
        }
      ]
    },
    {
      "name": "视频模块",
      "item": [
        {
          "name": "发布视频（需鉴权）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.code === 0) {",
                  "  pm.collectionVariables.set('video_id', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title",    "value": "测试视频标题", "type": "text" },
                { "key": "duration", "value": "60",          "type": "text" },
                { "key": "video",    "src": "",              "type": "file", "description": "选择本地视频文件" },
                { "key": "cover",    "src": "",              "type": "file", "description": "选择封面图片（可选）" }
              ]
            },
            "url": { "raw": "{{base_url}}/video/publish", "host": ["{{base_url}}"], "path": ["video", "publish"] }
          }
        },
        {
          "name": "获取视频详情",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/video/{{video_id}}", "host": ["{{base_url}}"], "path": ["video", "{{video_id}}"] }
          }
        },
        {
          "name": "作者视频列表（游标分页）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/video/list?author_id={{uid}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["video", "list"],
              "query": [
                { "key": "author_id",   "value": "{{uid}}" },
                { "key": "cursor_time", "value": "", "disabled": true },
                { "key": "cursor_id",   "value": "", "disabled": true },
                { "key": "limit",       "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Feed 流模块",
      "item": [
        {
          "name": "最新 Feed（latest）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/feed?type=latest&limit=10",
              "host": ["{{base_url}}"],
              "path": ["feed"],
              "query": [
                { "key": "type",   "value": "latest" },
                { "key": "cursor", "value": "", "disabled": true },
                { "key": "limit",  "value": "10" }
              ]
            }
          }
        },
        {
          "name": "关注流 Feed（following，需鉴权）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/feed?type=following&limit=10",
              "host": ["{{base_url}}"],
              "path": ["feed"],
              "query": [
                { "key": "type",   "value": "following" },
                { "key": "cursor", "value": "", "disabled": true },
                { "key": "limit",  "value": "10" }
              ]
            }
          }
        },
        {
          "name": "热榜 Feed（popularity）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/feed?type=popularity&limit=10",
              "host": ["{{base_url}}"],
              "path": ["feed"],
              "query": [
                { "key": "type",   "value": "popularity" },
                { "key": "cursor", "value": "", "disabled": true },
                { "key": "limit",  "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "点赞模块",
      "item": [
        {
          "name": "点赞视频（需鉴权）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"{{video_id}}\",\n  \"action_type\": 1\n}"
            },
            "url": { "raw": "{{base_url}}/like/action", "host": ["{{base_url}}"], "path": ["like", "action"] }
          }
        },
        {
          "name": "取消点赞（需鉴权）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"{{video_id}}\",\n  \"action_type\": 2\n}"
            },
            "url": { "raw": "{{base_url}}/like/action", "host": ["{{base_url}}"], "path": ["like", "action"] }
          }
        },
        {
          "name": "我点赞的视频列表（需鉴权）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/like/list?limit=10",
              "host": ["{{base_url}}"],
              "path": ["like", "list"],
              "query": [
                { "key": "cursor_time", "value": "", "disabled": true },
                { "key": "cursor_id",   "value": "", "disabled": true },
                { "key": "limit",       "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "评论模块",
      "item": [
        {
          "name": "发表评论（需鉴权）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.code === 0) {",
                  "  pm.collectionVariables.set('comment_id', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action_type\": 1,\n  \"video_id\": \"{{video_id}}\",\n  \"content\": \"这是一条测试评论\"\n}"
            },
            "url": { "raw": "{{base_url}}/comment/action", "host": ["{{base_url}}"], "path": ["comment", "action"] }
          }
        },
        {
          "name": "删除评论（需鉴权）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action_type\": 2,\n  \"comment_id\": \"{{comment_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/comment/action", "host": ["{{base_url}}"], "path": ["comment", "action"] }
          }
        },
        {
          "name": "评论列表（游标分页）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/comment/list?video_id={{video_id}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["comment", "list"],
              "query": [
                { "key": "video_id",    "value": "{{video_id}}" },
                { "key": "cursor_time", "value": "", "disabled": true },
                { "key": "cursor_id",   "value": "", "disabled": true },
                { "key": "limit",       "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "关注模块",
      "item": [
        {
          "name": "关注用户（需鉴权）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"followee_id\": \"{{target_uid}}\",\n  \"action_type\": 1\n}"
            },
            "url": { "raw": "{{base_url}}/follow/action", "host": ["{{base_url}}"], "path": ["follow", "action"] }
          }
        },
        {
          "name": "取关用户（需鉴权）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"followee_id\": \"{{target_uid}}\",\n  \"action_type\": 2\n}"
            },
            "url": { "raw": "{{base_url}}/follow/action", "host": ["{{base_url}}"], "path": ["follow", "action"] }
          }
        },
        {
          "name": "关注列表（游标分页）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/follow/following?user_id={{uid}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["follow", "following"],
              "query": [
                { "key": "user_id",     "value": "{{uid}}" },
                { "key": "cursor_time", "value": "", "disabled": true },
                { "key": "cursor_id",   "value": "", "disabled": true },
                { "key": "limit",       "value": "10" }
              ]
            }
          }
        },
        {
          "name": "粉丝列表（游标分页）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/follow/follower?user_id={{uid}}&limit=10",
              "host": ["{{base_url}}"],
              "path": ["follow", "follower"],
              "query": [
                { "key": "user_id",     "value": "{{uid}}" },
                { "key": "cursor_time", "value": "", "disabled": true },
                { "key": "cursor_id",   "value": "", "disabled": true },
                { "key": "limit",       "value": "10" }
              ]
            }
          }
        }
      ]
    }
  ]
}
